# Rust build artifacts (ALL excluded to prevent 10K+ changes)
/target/
*/target/
**/target/
# Cargo.lock IS committed for vector-bindings (the only Rust crate here) -
# see standards/rules/rust.md "Required Tooling"

# Vector source directory (build artifact - ignore entirely)
/vector/

# Python environments (NEVER track these - causes 10K+ git changes)
.venv/
*/.venv/
**/.venv/
__pycache__/
*/__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/dist/
*.egg-info/
# Python binary extensions (should not be tracked)
*.so
*.dylib
*.pyd

# IDE and editor files
.idea/
*.swp
*.swo
*~
.DS_Store

# Task and temporary files
.task/
test_outputs/
integration.toml

# pytest-cov output (every `make test-python` run regenerates these)
.coverage
coverage.xml

# Temporary files (controlled via LFS for important ones)
.tmp/
!.tmp/.gitkeep

# OS and system files
Thumbs.db
.Trash-*
*.log.backup

# Package manager files
Cargo.lock.backup
uv.lock.backup
node_modules/
npm-debug.log*

# Environment and secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.p12

# Build system internal files (prevent 10K+ changes)
build/.cache/
build/logs/
build/*.backup
vector-vrl/target/
vector-vrl/dist/
vector-bindings/target/

# Cargo registry and git checkouts (major source of 10K+ changes) -
# NOT .cargo/config.toml, which is meant to be committed
.cargo/registry/
.cargo/git/
*/.cargo/registry/
*/.cargo/git/
**/.cargo/registry/
**/.cargo/git/

# Rust incremental compilation data
*/incremental/
**/incremental/

# Large files (no longer using LFS since /vector is ignored)
*.tar.gz
*.zip
*.dmg
*.pkg
*.deb
*.rpm

# Per-developer AI tool settings - machine-local, never shared
.claude/
.cursor/
