# Rust build artifacts (ALL excluded to prevent 10K+ changes)
/target/
*/target/
**/target/
.cargo/
*/Cargo.lock
**/Cargo.lock

# Vector source directory (build artifact - ignore entirely)
/vector/

# Python environments (NEVER track these - causes 10K+ git changes)
.venv/
*/.venv/
**/.venv/
build/.venv/
vectordotdev/.venv/
vector/.venv/
vector-bindings/.venv/
__pycache__/
*/__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/dist/
*.egg-info/
# Python binary extensions (should not be tracked)
*.so
*.dylib
*.pyd

# IDE and editor files
.idea/
*.swp
*.swo
*~
.DS_Store

# Task and temporary files
.task/
test_outputs/
integration.toml

# Temporary files (controlled via LFS for important ones)
.tmp/
!.tmp/.gitkeep

# OS and system files
Thumbs.db
.Trash-*
*.log.backup

# Package manager files
Cargo.lock.backup
uv.lock.backup
node_modules/
npm-debug.log*

# Environment and secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.p12

# Build system internal files (prevent 10K+ changes)
build/.cache/
build/logs/
build/*.backup
build/target/
build/dist/
vectordotdev/target/
vectordotdev/dist/
vector/target/
vector-bindings/target/

# Cargo registry and git checkouts (major source of 10K+ changes)
.cargo/registry/
.cargo/git/
*/.cargo/
**/.cargo/

# Rust incremental compilation data
*/incremental/
**/incremental/

# Large files that should be in LFS instead
*.tar.gz
*.zip
*.dmg
*.pkg
*.deb
*.rpm