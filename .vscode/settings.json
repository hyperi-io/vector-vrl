{
    "files.exclude": {
        "**/.tmp": true,
        "**/target": true,
        "**/.cargo": true,
        "**/build/.venv": true,
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/node_modules": true,
        "**/*.pyc": true,
        "**/.DS_Store": true
    },
    "files.watcherExclude": {
        "**/.tmp/**": true,
        "**/target/**": true,
        "**/.cargo/**": true,
        "**/build/.venv/**": true,
        "**/__pycache__/**": true,
        "**/.mypy_cache/**": true,
        "**/node_modules/**": true
    },
    "search.exclude": {
        "**/.tmp": true,
        "**/target": true,
        "**/.cargo": true,
        "**/build/.venv": true,
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/node_modules": true
    },
    "git.ignoreLimitWarning": true,
    "git.useEditorAsCommitInput": false,
    "git.enabled": true,
    
    // Python-only linting and formatting
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    
    // Rust-only settings (no auto-formatting of Rust files)
    "[rust]": {
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": {}
    },
    
    // Scope Python tools to src/ directory only (NOT vector/)
    "python.analysis.include": [
        "src/**"
    ],
    "python.analysis.exclude": [
        "vector/**",
        "target/**", 
        ".cargo/**",
        "build/**"
    ],
    
    "ruff.include": [
        "src/**/*.py"
    ],
    "ruff.exclude": [
        "vector/**",
        "target/**",
        ".cargo/**",
        "build/**"
    ]
}