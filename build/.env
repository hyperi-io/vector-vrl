# Build system environment configuration
# JFrog PyPI deployment settings

# ============================================
# JFROG ARTIFACTORY SETTINGS
# ============================================

# JFrog repository configuration (no hardcoded values)
JFROG_BASE_URL=https://hypersec.jfrog.io/artifactory
JFROG_PYPI_REPO=hypersec-pypi-local
JFROG_API_URL=https://hypersec.jfrog.io/artifactory/api/pypi/hypersec-pypi-local/

# Deployment control flags
ENABLE_JFROG_DEPLOYMENT=OFF
ENABLE_CLEANUP_AFTER_DEPLOY=OFF

# Build system settings
VECTORDOTDEV_WHEEL_BUILD=ON
VECTORDOTDEV_INCLUDE_BINDINGS=ON
VECTORDOTDEV_INCLUDE_TESTS=OFF

# Debug and logging
DEBUG_DEPLOYMENT=OFF
VERBOSE_TWINE=ON