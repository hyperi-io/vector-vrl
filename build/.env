# Build system environment configuration
# JFrog PyPI deployment settings

# ============================================
# JFROG ARTIFACTORY SETTINGS
# ============================================

# JFrog repository configuration (no hardcoded values)
JFROG_BASE_URL=https://hypersec.jfrog.io/artifactory
JFROG_PYPI_REPO=hypersec-pypi-local
JFROG_API_URL=https://hypersec.jfrog.io/artifactory/api/pypi/hypersec-pypi-local/

# ============================================
# LOCAL DEPLOYMENT CREDENTIALS
# ============================================
# If these are set, GitHub Actions deployment is automatically disabled
# and local deployment is used instead

# ARTIFACTORY_TENANT_USERNAME=your_username_here
# ARTIFACTORY_TENANT_PASSWORD=your_password_here

# Alternative credential names (if different from organization secrets)
# ARTIFACTORY_USERNAME=your_username_here  
# ARTIFACTORY_PASSWORD=your_password_here

# Token-based authentication (alternative to username/password)
# JFROG_ACCESS_TOKEN=your_token_here

# ============================================
# DEPLOYMENT CONTROL FLAGS
# ============================================

# Local deployment (set to ON if credentials above are configured)
ENABLE_JFROG_DEPLOYMENT=OFF

# GitHub Actions control (automatically managed)
# If local credentials exist, GitHub Actions deployment is disabled
DISABLE_GITHUB_JFROG_DEPLOYMENT=OFF

# Other settings
ENABLE_CLEANUP_AFTER_DEPLOY=OFF
VECTORDOTDEV_WHEEL_BUILD=ON
VECTORDOTDEV_INCLUDE_BINDINGS=ON
VECTORDOTDEV_INCLUDE_TESTS=OFF

# Debug and logging
DEBUG_DEPLOYMENT=OFF
VERBOSE_TWINE=ON