#!/bin/bash
# Smart build system wrapper - ensures correct Python environment

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"

cd "$PROJECT_DIR"

# Ensure build environment exists
if [ ! -d "build/.venv" ]; then
    echo "[INFO] Creating build environment..."
    uv venv build/.venv --python 3.11
    
    # Install dependencies for build system (including dynaconf for config policy)
    uv pip install --python build/.venv requests click rich typer gitpython dynaconf
fi

# Run Python smart build system  
exec "$PROJECT_DIR/build/.venv/bin/python" "$PROJECT_DIR/build/smart_build_system.py" "$@"