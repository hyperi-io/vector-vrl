#!/bin/bash
# Smart build system wrapper - ensures correct Python environment

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"

cd "$PROJECT_DIR"

# Ensure Python build environment exists
if [ ! -d "src/.venv" ]; then
    echo "[INFO] Creating Python build environment..."
    uv venv src/.venv --python 3.11
    
    # Install dependencies using Python project configuration
    cd src
    uv pip install --python .venv -e .
    cd ..
fi

# Run Python smart build system  
exec "$PROJECT_DIR/src/.venv/bin/python" "$PROJECT_DIR/src/build_system/smart_build_system.py" "$@"